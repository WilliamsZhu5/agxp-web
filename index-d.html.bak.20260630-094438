<script>
/* ===== 语言切换（纯前端 toggle，默认中文）===== */
function setLang(语言){
  document.documentElement.lang = (语言==='zh') ? 'zh' : 'en';
  document.body.classList.toggle('zh', 语言==='zh');
  document.getElementById('lang-en').classList.toggle('active', 语言==='en');
  document.getElementById('lang-zh').classList.toggle('active', 语言==='zh');
  document.querySelectorAll('.i18n').forEach(function(el){
    var 文本 = (语言==='zh') ? el.getAttribute('data-zh') : el.getAttribute('data-en');
    if(文本!=null) el.innerHTML = 文本;
    // 输入框 placeholder 单独处理（i18n 用 data-zh-ph / data-en-ph）
    var 占位 = (语言==='zh') ? el.getAttribute('data-zh-ph') : el.getAttribute('data-en-ph');
    if(占位!=null) el.setAttribute('placeholder', 占位);
  });
}
/* 首次加载即渲染中文（默认语言＝中文）*/
setLang('zh');

/* ===== 一键复制 + 成功反馈 ===== */
function copyCmd(按钮){
  var 命令容器 = 按钮.parentElement.querySelector('[data-cmd-text]');
  var 文本 = 命令容器 ? 命令容器.textContent : '';
  var 完成 = function(){
    var 原文 = 按钮.getAttribute('data-' + (document.body.classList.contains('zh')?'zh':'en')) || '复制';
    按钮.classList.add('copied');
    按钮.textContent = document.body.classList.contains('zh') ? '已复制' : 'Copied';
    setTimeout(function(){ 按钮.classList.remove('copied'); 按钮.textContent = 原文; }, 1600);
  };
  if(navigator.clipboard && navigator.clipboard.writeText){
    navigator.clipboard.writeText(文本).then(完成).catch(function(){ 兜底复制(文本,完成); });
  } else { 兜底复制(文本,完成); }
}
function 兜底复制(文本,回调){
  var ta = document.createElement('textarea');
  ta.value = 文本; ta.style.position='fixed'; ta.style.opacity='0';
  document.body.appendChild(ta); ta.select();
  try{ document.execCommand('copy'); }catch(e){}
  document.body.removeChild(ta); 回调();
}

/* ===== 兴趣标签：点击淡出移除（纯前端演示，呼应"点掉不需要的"文案）===== */
function removeTag(按钮){
  var 标签 = 按钮.getAttribute('data-tag');
  if(!标签) return;
  // marquee 每个标签有两份副本（无缝循环用），同名一起移除以保持两组等宽、循环不错位
  document.querySelectorAll('.tag-pill[data-tag="'+标签+'"]').forEach(function(el){
    el.classList.add('removing');
    setTimeout(function(){ if(el.parentNode) el.parentNode.removeChild(el); }, 460);
  });
}

var 减弱动效 = window.matchMedia && window.matchMedia('(prefers-reduced-motion:reduce)').matches;

/* ===== 实时 timeline 演示：随机微动 ===== */
function 时间线微动(){
  var 库存 = 5 + Math.floor(Math.random()*5);
  var 承诺 = Math.floor(Math.random()*(库存-1));
  var 可用 = 库存 - 承诺;
  document.getElementById('tl-inv').textContent = 库存;
  document.getElementById('tl-commit').textContent = 承诺;
  document.getElementById('tl-avail').textContent = 可用;
  document.getElementById('tl-bar').style.width = Math.round(可用/库存*100) + '%';
}
if(!减弱动效) setInterval(时间线微动, 2400);

/* ===== 导航栏滚动描边 ===== */
var 顶栏 = document.getElementById('site-header');
window.addEventListener('scroll', function(){
  顶栏.classList.toggle('scrolled', window.scrollY > 8);
}, {passive:true});

/* ===== 区块进视口淡入（仅 opacity+transform，GPU 合成）===== */
if(减弱动效){
  document.querySelectorAll('.reveal').forEach(function(el){ el.classList.add('in'); });
}else{
  var 淡入观察 = new IntersectionObserver(function(条目){
    条目.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); 淡入观察.unobserve(e.target); } });
  }, {threshold:.12});
  document.querySelectorAll('.reveal').forEach(function(el){ 淡入观察.observe(el); });
}
</script>
